rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function staffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isActiveStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffData().active == true;
    }

    function role() {
      return staffData().role;
    }

    function isAdmin() { return isActiveStaff() && role() == 'Admin'; }
    function isSales() { return isActiveStaff() && role() == 'Sales Staff'; }
    function isInventory() { return isActiveStaff() && role() == 'Inventory Staff'; }

    // Public catalog — the storefront reads these signed out.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isInventory();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog content — public read, admin-only write (marketing copy, same trust
    // level as Categories).
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders are only ever created server-side, via firebase-admin, after a Paystack payment
    // verifies (src/app/api/payments/paystack/verify) — that path bypasses these rules
    // entirely, so no client `create` rule is needed or wanted here (a client `create` rule
    // would let anyone write junk orders straight to Firestore with no payment behind them).
    match /orders/{orderId} {
      allow read: if isActiveStaff();
      allow update: if isAdmin() || isSales();
      allow delete: if isAdmin();
    }

    // Same reasoning as orders — created server-side only, via firebase-admin, after a
    // wholesale Paystack payment verifies. No client create rule.
    match /wholesaleOrders/{orderId} {
      allow read: if isActiveStaff();
      allow update: if isAdmin() || isSales();
      allow delete: if isAdmin();
    }

    // Lightweight wholesale CRM record, upserted server-side alongside wholesale order
    // creation — staff can look customers up, nobody writes it from the client.
    match /businessCustomers/{customerId} {
      allow read: if isActiveStaff();
      allow write: if false;
    }

    // Monthly revenue rollup (revenueStats/{YYYY-MM}), incremented server-side at order
    // creation and read by the analytics dashboard. Staff read, server-only write.
    match /revenueStats/{month} {
      allow read: if isActiveStaff();
      allow write: if false;
    }

    // Any signed-in staff member can read the roster (to resolve their own
    // role); only Admins manage it.
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Append-only staff action log — any active staff member logs their own actions;
    // only Admin can review the log, and nobody can edit or delete an entry.
    match /activity_log/{logId} {
      allow read: if isAdmin();
      allow create: if isActiveStaff();
      allow update, delete: if false;
    }

    // Store settings — public read because the storefront itself depends on this doc
    // (hero copy, promotion banner, theme colors, page content, general contact info are
    // all read by anonymous visitors on every page load via AdminDataProvider). Only
    // Admins can write. Paystack keys are NOT stored here — they live in server env vars
    // (PAYSTACK_SECRET_KEY, NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY), same as Arkesel/Brevo.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
